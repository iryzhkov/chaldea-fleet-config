# Managed by chaldea-fleet-config (roles/mise_agents); local edits are overwritten.
# chaldea-fleet-pull installs the newest release of each tool that is at least
# {{ mise_agents_minimum_release_age }} old. Plain version strings only: tool options would need mise trust.
# User-declared tools are omitted, including their equivalent registry identities.
[tools]
{% for tool in mise_agents_owned.tools | sort(attribute='name') %}
{{ tool.name | to_json }} = "latest"
{% endfor %}
