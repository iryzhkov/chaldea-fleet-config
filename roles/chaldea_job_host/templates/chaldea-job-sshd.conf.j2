Port {{ chaldea_job_host_port }}
ListenAddress 0.0.0.0
ListenAddress ::
PidFile /run/chaldea-job-sshd.pid
AllowUsers chaldea-job
HostKey /etc/ssh/ssh_host_ed25519_key
AuthorizedKeysFile /home/chaldea-job/.ssh/authorized_keys
StrictModes yes
UsePAM no
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
PermitUserEnvironment no
ClientAliveInterval 15
ClientAliveCountMax 2
LoginGraceTime 30
MaxAuthTries 2
MaxSessions 1
LogLevel ERROR
Match User chaldea-job
    ForceCommand {{ chaldea_job_host_server }}
    DisableForwarding yes
    AllowTcpForwarding no
    AllowStreamLocalForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
    PermitTTY no
    PermitUserRC no
