[Unit]
Description=Chaldea restricted compute SSH
After=network.target ufw.service
[Service]
Type=simple
Slice=chaldea.slice
ExecStartPre={{ chaldea_job_host_sshd_binary }} -t -f /etc/ssh/chaldea-job-sshd.conf
ExecStart={{ chaldea_job_host_sshd_binary }} -D -e -f /etc/ssh/chaldea-job-sshd.conf
Restart=on-failure
RestartSec=3
KillMode=control-group
MemoryMax={{ chaldea_job_host_memory_max }}
MemorySwapMax=0
OOMPolicy=kill
TasksMax={{ chaldea_job_host_tasks_max }}
CPUWeight={{ chaldea_job_host_cpu_weight }}
IOWeight={{ chaldea_job_host_io_weight }}
LogNamespace=chaldea-job
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20
[Install]
WantedBy=multi-user.target
