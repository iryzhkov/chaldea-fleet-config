# Only the dedicated daemon on {{ chaldea_job_host_port }} admits this account.
Match User chaldea-job
    DenyUsers chaldea-job
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    DisableForwarding yes
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
    PermitTTY no
    PermitUserRC no
Match all
