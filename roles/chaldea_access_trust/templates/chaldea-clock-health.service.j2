[Unit]
Description=Chaldea fail-closed chrony health adapter
After=chronyd.service chrony.service

[Service]
Type=oneshot
User=root
UMask=0022
RuntimeDirectory=chaldea-access-trust
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart={{ chaldea_access_trust_node }} {{ chaldea_access_trust_runtime }} clock-health --output {{ chaldea_access_trust_run }}/clock-health.json
TimeoutStartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ chaldea_access_trust_run }}
