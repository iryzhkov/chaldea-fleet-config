# Managed by chaldea-fleet-config.
[Unit]
Description=Chaldea durable waits and decision inbox
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/share/mise/installs/node/{{ chaldea_node_version }}/bin/node %h/.local/share/chaldea/current/bin/chaldea waits serve --config %h/.config/chaldea/waits.json
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
StateDirectory=chaldea
CacheDirectory=chaldea-waits
Restart=on-failure
RestartSec=5
UMask=0077
Environment=TMPDIR=%h/.cache/chaldea-waits
ExecStartPre=/usr/bin/mkdir -p %h/.cache/chaldea-waits
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/chaldea %h/.cache/chaldea-waits %t
PrivateTmp=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
